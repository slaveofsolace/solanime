# Local-only API binding.
HOST=127.0.0.1
PORT=8787
SOLANIME_DB_PATH=E:\\CodexProjects\\solanime\\data\\solanime.sqlite

# Required only for pause/resume/retry/backup HTTP actions. Generate a fresh
# local value; never commit the real token.
SOLANIME_ADMIN_TOKEN=replace-with-a-long-random-local-token

# Conservative public-source request policy.
SOLANIME_SOURCE_DELAY_MS=1200
SOLANIME_SOURCE_TIMEOUT_MS=20000
SOLANIME_SOURCE_MAX_RETRIES=4
SOLANIME_MAX_RETRY_AFTER_MS=86400000
