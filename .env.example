# Copy to .env. Shell environment variables take precedence.
HOST=127.0.0.1
PORT=8787
SOLANIME_DB_PATH=data/solanime.sqlite
# Optional. Leave blank to disable administrative operations.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLANIME_ADMIN_TOKEN=
# Exact public frontend origins, comma-separated, only when using the Pages gateway.
SOLANIME_ALLOWED_ORIGINS=
SOLANIME_SOURCE_DELAY_MS=1200
SOLANIME_SOURCE_TIMEOUT_MS=20000
SOLANIME_SOURCE_MAX_RETRIES=4
SOLANIME_MAX_RETRY_AFTER_MS=86400000

# Accounts use a separate private database. Persist this directory on the Node host.
SOLANIME_ACCOUNTS_DB_PATH=data/private/accounts.sqlite
# Required HTTPS public frontend origin in production; local dev uses the request origin.
# SOLANIME_APP_ORIGIN=https://your-frontend.example
SOLANIME_REGISTRATION=open
# Optional registered native MP4/HLS/DASH sources; no embed scraping or token spoofing.
# SOLANIME_NATIVE_SOURCES=config/native-sources.json

# Optional shared server-side secret for trusted Pages client-IP forwarding.
# Set the same random value in Pages runtime and the Node environment; never use a VITE_ prefix.
# SOLANIME_GATEWAY_TOKEN=
