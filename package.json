{
  "name": "solanime",
  "version": "0.8.4-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm api:dev\" \"pnpm web:dev\"",
    "api": "node --env-file-if-exists=.env --import tsx server/app.ts",
    "api:dev": "node --env-file-if-exists=.env --watch --import tsx server/app.ts",
    "web:dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:private-site": "pnpm build && playwright test --config playwright.private.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "import:anikoto": "node --env-file-if-exists=.env --import tsx scripts/import-anikoto.ts",
    "import:tvmaze": "node --env-file-if-exists=.env --import tsx scripts/import-tvmaze.ts",
    "import:wikipedia": "node --env-file-if-exists=.env --import tsx scripts/import-wikipedia.ts",
    "import:detached": "node --env-file-if-exists=.env --import tsx scripts/start-full-import.ts",
    "import:status": "node --env-file-if-exists=.env --import tsx scripts/import-status.ts",
    "resolve:sources": "node --env-file-if-exists=.env --import tsx scripts/resolve-episode-sources.ts",
    "resolve:sources:detached": "node scripts/start-source-resolution.mjs",
    "export:data": "node --env-file-if-exists=.env --import tsx scripts/export-data.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts",
    "verify:database": "node --env-file-if-exists=.env --import tsx scripts/verify-database.ts",
    "audit:playback-coverage": "node --env-file-if-exists=.env --import tsx scripts/audit-playback-coverage.ts",
    "audit:playback-coverage:strict": "node --env-file-if-exists=.env --import tsx scripts/audit-playback-coverage.ts --strict",
    "verify:catalogue-scopes": "node --import tsx scripts/audit-catalogue-scopes.ts",
    "verify:providers": "node --env-file-if-exists=.env --import tsx scripts/verify-providers.ts",
    "approve:youtube-official": "node --env-file-if-exists=.env --import tsx scripts/approve-official-youtube.ts",
    "discover:youtube-official": "node --env-file-if-exists=.env --import tsx scripts/discover-official-youtube.ts",
    "discover:youtube-official:detached": "node scripts/start-official-youtube-discovery.mjs",
    "plan:youtube-official": "node --env-file-if-exists=.env --import tsx scripts/plan-youtube-official-batch.ts",
    "verify:youtube-official-batch": "node --env-file-if-exists=.env --import tsx scripts/verify-youtube-official-batch.ts",
    "audit:provider-failures": "node --env-file-if-exists=.env --import tsx scripts/audit-provider-task-failures.ts",
    "audit:empty-episodes": "node --env-file-if-exists=.env --import tsx scripts/audit-empty-episode-lists.ts",
    "repair:freshness": "node --env-file-if-exists=.env --import tsx scripts/repair-ancestor-freshness.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/app.ts --serve-static",
    "preview": "vite preview",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:privacy",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "test:guard": "pnpm build && playwright test --config playwright.guard.config.ts",
    "verify:privacy": "node scripts/verify-privacy.mjs dist",
    "verify:provider-playback": "node scripts/verify-provider-playback.mjs",
    "backup:accounts": "node --env-file-if-exists=.env --import tsx scripts/backup-accounts.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:private-approval": "node scripts/verify-private-approval.mjs",
    "cloud:types": "wrangler types --env-interface CloudEnv --strict-vars=false",
    "cloud:migrate:catalogue": "wrangler d1 migrations apply CATALOGUE --remote --env=\"\"",
    "cloud:migrate:accounts": "wrangler d1 migrations apply ACCOUNTS --remote --env=\"\"",
    "cloud:migrate:research": "wrangler d1 migrations apply RESEARCH --remote --env=\"\"",
    "cloud:deploy:api": "wrangler deploy --env=\"\"",
    "cloud:staging:migrate:catalogue": "wrangler d1 migrations apply CATALOGUE --remote --env staging",
    "cloud:staging:migrate:accounts": "wrangler d1 migrations apply ACCOUNTS --remote --env staging",
    "cloud:staging:migrate:research": "wrangler d1 migrations apply RESEARCH --remote --env staging",
    "cloud:staging:deploy:api": "wrangler deploy --env staging",
    "cloud:deploy:preview": "node scripts/deploy-pages.mjs --branch=cloud-release",
    "cloud:import:prepare": "node --import tsx scripts/cloud-data/prepare.ts",
    "cloud:import:upload": "node --import tsx scripts/cloud-data/upload.ts",
    "cloud:baseline:prepare": "node --import tsx scripts/cloud-data/prepare-baseline.ts",
    "cloud:assets:stage": "node --import tsx scripts/cloud-data/stage-worker-assets.ts",
    "cloud:control": "node scripts/cloud-control.mjs",
    "fonts:sync": "node scripts/copy-manrope-fonts.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "dashjs": "5.2.1",
    "hls.js": "1.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "miniflare": "5.20260911.0-alpha",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@11.19.0"
}
